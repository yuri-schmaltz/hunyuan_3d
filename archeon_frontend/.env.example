# =============================================================================
# Archeon frontend — Vite env
# =============================================================================
# Copy to `.env` (or `.env.development` / `.env.production` per Vite's
# loading rules) and adjust for your setup. Variables must be prefixed with
# ``VITE_`` to be exposed to the browser code.
#
# Quick reference:
#   cp archeon_frontend/.env.example archeon_frontend/.env
#   make dev    # reads archeon_frontend/.env automatically
# =============================================================================


# Base URL of the Archeon API. In dev this points at the local server on
# 8081; in production it should be the public URL of the API (e.g.
# https://api.archeon.example.com).
VITE_API_URL=http://localhost:8081

# If the API is behind an auth proxy, paste the key here. **This exposes
# the key to every browser visitor** — use only for trusted internal apps.
# For public deployments, leave empty and rely on a server-side auth proxy.
VITE_API_KEY=

# Default inference device label shown in the UI. Cosmetic only.
VITE_BRAND_NAME=Archeon

# Optional: a comma-separated list of allowed model choices shown in the
# advanced settings panel. Falls back to a hard-coded list if empty.
VITE_DEFAULT_MODEL=Hunyuan3D-2
