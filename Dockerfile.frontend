# Frontend build: Node 20, Vite, then serve with nginx.
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps first (better layer caching).
COPY archeon_frontend/package*.json ./
RUN npm ci --no-audit --no-fund

# Build the bundle.
COPY archeon_frontend/ ./
ARG VITE_API_URL=http://localhost:8081
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# -----------------------------------------------------------------------------
# Runtime: small nginx image serving the static bundle.
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine

# Replace the default config with one that SPA-fallbacks to index.html
# and proxies /v1 + /files to the backend.
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/

# Copy the built bundle.
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O- http://localhost/ >/dev/null || exit 1
