# =============================================================================
# .dockerignore — keep the build context small.
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Local env files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtualenvs
.venv/
venv/
env/

# Test + lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Frontend (built inside the image from package.json)
archeon_frontend/node_modules
archeon_frontend/dist

# Worktrees
.worktrees/

# Docs
docs/
*.md
!ARCHEON_README.md
!README.md

# Editor temp
*.log
.DS_Store
Thumbs.db

# Caches
.huggingface/
.cache/
